# Copy to .env (local) and set the same names in Vercel project settings.
G8_API_KEY=                 # graph8 API key (Settings → API). Single-org key for org_5e2170609156.
G8_ORG_ID=org_5e2170609156
G8_WEBHOOK_SECRET=          # returned once when the webhook for the deployed receiver is created
DASHBOARD_PASSWORD=         # gate for the dashboard
MCP_TOKEN=                  # bearer token required by /api/mcp
CRON_SECRET=                # bearer for /api/cron/*; Vercel cron sends it automatically
REDIS_URL=                  # Upstash Redis (only needed for the MCP SSE transport)
ACTION_CREDIT_CAP=          # per-action credit cap for guardrail runs (default 50)
ADVISOR_URL=                # deployed dashboard URL, used by the sim/register scripts
ROI_ADVISOR_CHANNEL=        # recap channel inside graph8 (default roi-advisor)
ROI_FIT_COLUMN_ID=757
ROI_FIT_FORMULA_NAME=udo_roi_fit_11e946f0
ROI_FIT_REASON_COLUMN_ID=   # column that stores the roi_fit reason (documented name)
RECORD_CONSISTENCY_COLUMN_ID=     # column created by scripts/bootstrap.ts for record consistency
RECORD_CONSISTENCY_FORMULA_NAME=  # formula name for the record-consistency check (documented name)
